{
  "name": "dsh-custom-css",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eigenes CSS für die DSH-Weboberfläche: Schriften, Radien, Kontraste, Elemente ausblenden.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-general"]
    }
  }
}
